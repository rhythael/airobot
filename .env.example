# SmartFoodie 041 语音助手 —— 凭据与机器相关设置。复制为 .env 后填写；.env 已被 gitignore。
# 启动脚本只把这些值注入进程内存，不写进任何配置文件。
# EN: credentials and host-specific settings. Copy to .env and fill in; .env is gitignored.
#     The launchers inject these values into process memory only; no config file ever holds them.

# 大模型 API Key / LLM API key（selected_module.LLM 所选的 provider；火山方舟 / DeepSeek / 其它 OpenAI 兼容服务）
LLM_API_KEY=

# 中央厨房接口的 App Key（库存桥用）/ Central Kitchen app key (inventory bridge)
SF_APP_KEY=

# 可选：火山语音合成（只有把 TTS 切到 HuoshanDoubleStreamTTS 才需要）
#SPEECH_APPID=
#SPEECH_ACCESS_TOKEN=

# 可选：库存桥参数（默认值即生产值）
#ALLOWED_MACHINE_NUMBERS=041
#CENTRAL_KITCHEN_BASE_URL=https://inventory-api.example.com/api

# 可选：解释器位置（默认依次找 <repo>/.venv、~/.venvs/…、PATH 里的 python3）
#SERVER_PYTHON=/opt/airobot/.venv/bin/python
#BRIDGE_PYTHON=/opt/airobot/bridge/.venv/bin/python
