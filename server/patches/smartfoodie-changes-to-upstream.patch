+        late = [pos for pos in cuts if pos >= limit // 3]
+        if late:
+            return late[-1]
+    spaces = [m.end() for m in re.finditer(r"\s", prefix) if m.end() >= limit // 2]
+    return spaces[-1] if spaces else limit
