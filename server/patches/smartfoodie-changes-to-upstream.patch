+def _speech_weight(text):
+    """粗估一段文字念出来有多长：汉字约 4.5 字/秒，字母数字约 14 个/秒。"""
+    cjk = len(re.findall(r"[一-鿿]", text))
+    latin = len(re.findall(r"[A-Za-z0-9ÄÖÜäöüß]", text))
+    return cjk + latin / 3
