+def trim_silence(audio, lead_keep_ms=30, tail_keep_ms=100, threshold_db=-50.0):
+    """裁掉合成音频首尾的静音。
+
+    EdgeTTS 会把短句补到约 1.87 秒，多出来的全是静音：「gerne」实际发音 0.44 秒，
+    尾部静音 1.21 秒，开头还有 150-230 毫秒。按句合成再逐句拼接时，每个句子
+    交界处都白白多出一秒多的空白，实机上听起来就是断断续续。
+    首尾各留一点，避免吃掉起音和尾音。
+    """
+    from pydub.silence import detect_leading_silence
+
+    total = len(audio)
+    if total == 0:
+        return audio
+    lead = detect_leading_silence(audio, silence_threshold=threshold_db)
+    if lead >= total:
+        return audio  # 整段都是静音，原样返回，交给上游判断
+    tail = detect_leading_silence(audio.reverse(), silence_threshold=threshold_db)
+    start = max(0, lead - lead_keep_ms)
+    end = min(total, total - tail + tail_keep_ms)
+    return audio[start:end]
