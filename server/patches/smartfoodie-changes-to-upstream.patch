+    def _capture_stream(self, pcm_frame):
+        """诊断用：把设备传来的每个音频包连续写进一个 wav，并记下每个包的到达时间。
+        用来判断句首丢失是设备没传，还是服务端没接住。会录下说话人的声音，测完删。"""
+        try:
+            import wave as _wave
+            if getattr(self, "_stream_wav", None) is None:
+                d = self.config["audio_stream_capture_dir"]
+                os.makedirs(d, exist_ok=True)
+                base = os.path.join(d, f"stream-{time.strftime('%Y%m%d-%H%M%S')}")
+                self._stream_wav = _wave.open(base + ".wav", "wb")
+                self._stream_wav.setnchannels(1)
+                self._stream_wav.setsampwidth(2)
+                self._stream_wav.setframerate(16000)
+                self._stream_log = open(base + ".events", "a", buffering=1)
+                self._stream_samples = 0
+            self._stream_log.write(f"{time.time():.3f} packet {self._stream_samples} {len(pcm_frame)}\n")
+            self._stream_wav.writeframes(pcm_frame)
+            self._stream_samples += len(pcm_frame) // 2
+        except Exception as e:
+            self.logger.bind(tag=TAG).warning(f"音频流采集失败: {e}")
+
+    def _stream_event(self, name, detail=""):
+        log = getattr(self, "_stream_log", None)
+        if log:
+            try:
+                log.write(f"{time.time():.3f} {name} {detail}\n")
+            except Exception:
+                pass
