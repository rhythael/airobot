+def _chunk_cut(prefix, limit, first):
+    """超长段落在哪里切。原来取「后半截里最后一个标点或空格」，本地直答整段到达时
+    常切在空格上：「Fried Rice with Asian | Sausage」，菜名中间停顿；中文短首句
+    「现在有七种可买。」也被并进中英混排段，用不上首句本地合成（2026-10-05）。
+    现在按优先级：首段先在第一个句末切（够 4 个字），其余段取后段最后一个句末，
+    再取最后一个逗号顿号，最后才退回空格，空格也找不到就硬切。"""
+    def solid(pos):
+        return len(re.sub(r"\s", "", prefix[:pos])) >= 4
+
