+async def local_endpoint_available(config):
+    """Probe loopback HTTP endpoints only; remote and stdio initialization stay unchanged."""
+    if config.get("command") or not config.get("url"):
+        return True
+    endpoint = urlsplit(config["url"])
+    if endpoint.scheme not in ("http", "https") or endpoint.hostname not in ("127.0.0.1", "localhost", "::1"):
+        return True
+    try:
+        _, writer = await asyncio.wait_for(
+            asyncio.open_connection(endpoint.hostname, endpoint.port or (443 if endpoint.scheme == "https" else 80)),
+            timeout=0.3,
+        )
+        writer.close()
+        await writer.wait_closed()
+        return True
+    except (OSError, asyncio.TimeoutError):
+        return False
+
